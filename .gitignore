# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Committable environment template
!.env.example
/test-results/
/playwright-report/
/supabase/.temp/
/supabase/.branches/

# Capacitor dependencies, build products, generated bridge assets, and local signing state
/ios-shell/node_modules/
/ios-shell/ios/App/App/public/
/ios-shell/ios/App/App/capacitor.config.json
/ios-shell/ios/App/App/config.xml
/ios-shell/ios/App/Pods/
/ios-shell/ios/**/xcuserdata/
/ios-shell/ios/DerivedData/
